{
  "info": {
    "name": "Digital Asset Platform - Gold Tokenization",
    "description": "Complete flow: Register → Login → KYC → Wallet → Tokenize → Mint → Transfer → Settle → Audit",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",         "value": "http://localhost:8080" },
    { "key": "adminToken",      "value": "" },
    { "key": "investorToken",   "value": "" },
    { "key": "adminId",         "value": "" },
    { "key": "investorId",      "value": "" },
    { "key": "adminWalletId",   "value": "" },
    { "key": "investorWalletId","value": "" },
    { "key": "assetId",         "value": "" },
    { "key": "settlementId",    "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"email\": \"admin@goldvault.com\",\n  \"password\": \"Admin@1234\",\n  \"fullName\": \"Gold Vault Admin\",\n  \"role\": \"ADMIN\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.id) pm.collectionVariables.set('adminId', r.data.id);"
            ]}
          }]
        },
        {
          "name": "Register Investor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"investor1\",\n  \"email\": \"investor@example.com\",\n  \"password\": \"Invest@1234\",\n  \"fullName\": \"Alice Investor\",\n  \"role\": \"INVESTOR\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.id) pm.collectionVariables.set('investorId', r.data.id);"
            ]}
          }]
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin1\",\n  \"password\": \"Admin@1234\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.accessToken) pm.collectionVariables.set('adminToken', r.data.accessToken);",
              "pm.test('Login successful', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "Login Investor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/users/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"investor1\",\n  \"password\": \"Invest@1234\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.accessToken) pm.collectionVariables.set('investorToken', r.data.accessToken);",
              "pm.test('Login successful', () => pm.response.to.have.status(200));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "2. KYC",
      "item": [
        {
          "name": "Approve Investor KYC",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/users/{{investorId}}/kyc",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"kycStatus\": \"APPROVED\"\n}"
            }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{investorId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "3. Wallets",
      "item": [
        {
          "name": "Create Admin Wallet (GLD)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet/wallets",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetType\": \"GLD\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.id) pm.collectionVariables.set('adminWalletId', r.data.id);"
            ]}
          }]
        },
        {
          "name": "Create Investor Wallet (GLD)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet/wallets",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{investorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assetType\": \"GLD\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.id) pm.collectionVariables.set('investorWalletId', r.data.id);"
            ]}
          }]
        },
        {
          "name": "Get Admin Wallet Balance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/wallets/{{adminWalletId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Investor Wallet Balance",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/wallets/{{investorWalletId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{investorToken}}" }]
          }
        },
        {
          "name": "List My Wallets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/wallet/wallets",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "4. Asset Tokenization",
      "item": [
        {
          "name": "Tokenize 1 KG Gold → 1000 GLD",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/assets/assets/tokenize",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gold Bar #001\",\n  \"physicalQuantity\": 1.0,\n  \"tokenRatio\": 1000,\n  \"assetType\": \"GLD\",\n  \"vaultRef\": \"VAULT-DUBAI-001\",\n  \"smartContractAddress\": \"0xfe3b557e8fb62b89f4916b721be55ceb828dbd73\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.id) pm.collectionVariables.set('assetId', r.data.id);",
              "pm.test('Asset created', () => pm.response.to.have.status(200));"
            ]}
          }]
        },
        {
          "name": "Mint 1000 GLD to Admin Wallet",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/assets/assets/{{assetId}}/mint",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{adminWalletId}}\",\n  \"amount\": 1000,\n  \"reason\": \"Initial tokenization of 1 KG gold bar VAULT-DUBAI-001\"\n}"
            }
          }
        },
        {
          "name": "Get Asset Details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assets/assets/{{assetId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "List All Assets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/assets/assets",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Burn 50 GLD (gold withdrawal)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/assets/assets/{{assetId}}/burn",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": \"{{adminWalletId}}\",\n  \"amount\": 50,\n  \"reason\": \"Physical gold withdrawal by owner\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Transfers",
      "item": [
        {
          "name": "Transfer 100 GLD Admin → Investor",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet/wallets/transfer",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": \"{{adminWalletId}}\",\n  \"toWalletId\": \"{{investorWalletId}}\",\n  \"amount\": 100,\n  \"memo\": \"Purchase of 100 GLD tokens\"\n}"
            }
          }
        },
        {
          "name": "Transfer 25 GLD back Investor → Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/wallet/wallets/transfer",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{investorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromWalletId\": \"{{investorWalletId}}\",\n  \"toWalletId\": \"{{adminWalletId}}\",\n  \"amount\": 25,\n  \"memo\": \"Partial redemption\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "6. Settlement (DvP)",
      "item": [
        {
          "name": "Initiate Settlement",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/settlements/settlements",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyerWalletId\": \"{{investorWalletId}}\",\n  \"sellerWalletId\": \"{{adminWalletId}}\",\n  \"assetId\": \"{{assetId}}\",\n  \"tokenAmount\": 50,\n  \"paymentAmount\": 2500.00,\n  \"paymentCurrency\": \"USD\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "var r = pm.response.json();",
              "if (r.data && r.data.settlementId) pm.collectionVariables.set('settlementId', r.data.settlementId);"
            ]}
          }]
        },
        {
          "name": "Complete Settlement",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/settlements/settlements/{{settlementId}}/complete",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Settlement Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/settlements/settlements/{{settlementId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "List All Settlements",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/settlements/settlements",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "7. Audit & Ledger",
      "item": [
        {
          "name": "Get All Audit Logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ledger/audit-logs",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Audit Logs - TOKEN_MINTED",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ledger/audit-logs?eventType=TOKEN_MINTED",
              "query": [{ "key": "eventType", "value": "TOKEN_MINTED" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Audit Logs - TOKEN_TRANSFERRED",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ledger/audit-logs?eventType=TOKEN_TRANSFERRED",
              "query": [{ "key": "eventType", "value": "TOKEN_TRANSFERRED" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Audit Logs - SETTLEMENT_COMPLETED",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/ledger/audit-logs?eventType=SETTLEMENT_COMPLETED",
              "query": [{ "key": "eventType", "value": "SETTLEMENT_COMPLETED" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "8. Blockchain",
      "item": [
        {
          "name": "Get Token Balance (on-chain)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/blockchain/balance/0xfe3b557e8fb62b89f4916b721be55ceb828dbd73",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        },
        {
          "name": "Get Transaction Receipt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/blockchain/transaction/{{txHash}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          }
        }
      ]
    },
    {
      "name": "9. Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": { "method": "GET", "url": "{{baseUrl}}/actuator/health" }
        },
        {
          "name": "User Service Health",
          "request": { "method": "GET", "url": "http://localhost:8081/actuator/health" }
        },
        {
          "name": "Wallet Service Health",
          "request": { "method": "GET", "url": "http://localhost:8082/actuator/health" }
        },
        {
          "name": "Asset Service Health",
          "request": { "method": "GET", "url": "http://localhost:8083/actuator/health" }
        },
        {
          "name": "Blockchain Service Health",
          "request": { "method": "GET", "url": "http://localhost:8084/actuator/health" }
        },
        {
          "name": "Ledger Service Health",
          "request": { "method": "GET", "url": "http://localhost:8085/actuator/health" }
        },
        {
          "name": "Settlement Service Health",
          "request": { "method": "GET", "url": "http://localhost:8086/actuator/health" }
        }
      ]
    }
  ]
}
