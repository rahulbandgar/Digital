# Copy this to .env and fill in your values — NEVER commit .env
WALLET_ADDRESS=0xYourEthereumWalletAddress
NETWORK=sepolia
DRY_RUN=false

# Database
DB_USERNAME=ethuser
DB_PASSWORD=strongpassword123

# API dashboard login
API_USERNAME=admin
API_PASSWORD=strongapipassword

# Faucet toggles
SEPOLIA_POW_ENABLED=true
HOLESKY_POW_ENABLED=false

# Optional: API-key faucets (leave blank to disable)
QUICKNODE_ENABLED=false
QUICKNODE_API_KEY=

ALCHEMY_ENABLED=false
ALCHEMY_API_KEY=

# Schedule (default: daily 08:00 UTC)
CLAIM_CRON=0 0 8 * * ?
