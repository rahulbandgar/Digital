# Copy this to .env and fill in your values — NEVER commit .env
WALLET_ADDRESS=0xYourEthereumWalletAddress
NETWORK=sepolia
DRY_RUN=false

# Database
DB_USERNAME=ethuser
DB_PASSWORD=strongpassword123

# API dashboard login
API_USERNAME=admin
API_PASSWORD=strongapipassword

# Primary faucet: Chainstack (API key, no captcha, 0.5 Sepolia ETH/24h)
# Get a free key at https://console.chainstack.com → Profile → API keys
CHAINSTACK_ENABLED=true
CHAINSTACK_API_KEY=

# pk910 PoW faucet — DISABLED: needs a captcha token, can't run unattended
SEPOLIA_POW_ENABLED=false
HOLESKY_POW_ENABLED=false

# Optional: other API-key faucets (leave blank to disable)
QUICKNODE_ENABLED=false
QUICKNODE_API_KEY=

# Schedule (default: daily 08:00 UTC)
CLAIM_CRON=0 0 8 * * ?
